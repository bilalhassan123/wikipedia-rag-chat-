# Copy this file to `.env` for local overrides. The defaults below match what
# `docker compose up` uses, so a fresh clone needs no `.env` for the happy path.

# --- Local model runtime (Ollama) -------------------------------------------
OLLAMA_HOST=http://ollama:11434
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# --- Vector store (Qdrant) --------------------------------------------------
QDRANT_HOST=http://qdrant:6333
QDRANT_COLLECTION=wiki_article

# --- RAG parameters (locked defaults from DESIGN.md; tune at your own risk) -
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# --- Backend ----------------------------------------------------------------
LOG_LEVEL=INFO
